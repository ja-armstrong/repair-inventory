# RMS settings. Copy this file to `.env` (in the project root) and fill in the
# values — the server loads `.env` at startup and refuses to run until the
# required keys are set. See README.md ("Configure") for the full descriptions.

# REQUIRED. The email domains accounts may belong to, comma-separated.
# Checked at every user creation and login-link request.
ALLOWED_EMAIL_DOMAINS=@acme.co,@acme.com

# REQUIRED. The password for the admin panel at /admin (this is also how the
# first user is created). Leave empty and the admin panel stays disabled.
ADMIN_KEY=

# Fallback web address used to build login links when the browser did not send
# an Origin header. Normally unnecessary.
APP_ORIGIN=http://localhost

# Where the database file lives. Default: data/repair-inventory.sqlite.
DB_PATH=

# The port the API server listens on. Default: 3000.
PORT=

# Resend (resend.com) API key. Set: login links are sent as real email.
# Empty: links are printed in the server console only.
RESEND_KEY=

# Sender address for login-link emails, e.g. RMS <no-reply@example.com>.
# Default: RMS <onboarding@resend.com>, Resend's shared test sender.
RESEND_FROM=

# Set to true only when the server runs under a supervisor that restarts it
# (NSSM service, pm2, ...). Unlocks the Restart button in the admin panel.
ALLOW_RESTART=
